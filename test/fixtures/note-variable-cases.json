  {
    "name": "first definition wins",
    "input": "a:: one\na:: two\nA:: three\n{{a}}",
    "definitions": [["a", "one"]],
    "resolved": "a:: one\na:: two\nA:: three\none",
    "display": "a: one\na: two\nA: three\none"
  },
  {
