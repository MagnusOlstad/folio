+    private func detectLanguage(encoderHidden: MLXArray, tokenizer: WhisperTokenizer) -> String? {
+        guard tokenizer.isMultilingual, !tokenizer.languageToId.isEmpty else { return nil }
+        var caches = (0..<config.decoderLayers).map { _ in WhisperLayerCache() }
+        let startToken = MLXArray([Int32(tokenizer.startOfTranscriptId)]).expandedDimensions(axis: 0)
+        let hidden = model.decoder(
+            tokens: startToken,
+            startPosition: 0,
+            encoderHidden: encoderHidden,
+            caches: &caches
+        )
+        let logits = model.decoder.projectToVocab(hidden[0, -1])
+        eval(logits)
+
+        var languageMask = [Float](repeating: -1e9, count: logits.dim(-1))
+        for tokenID in tokenizer.languageToId.values where tokenID >= 0 && tokenID < languageMask.count {
+            languageMask[tokenID] = 0
+        }
+        let languageTokenID = (logits + MLXArray(languageMask).asType(logits.dtype))
+            .argMax(axis: -1).item(Int.self)
+        return tokenizer.languageToId.first(where: { $0.value == languageTokenID })?.key
+    }
+
