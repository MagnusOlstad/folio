+        let mergedRows: Int
+        let mergedColumns: Int
+    }
+
+    /// Image tokens laid out like Pixtral's processor: each row of merged patches ends with
+    /// the break token, and the final row ends with the end token. Without both tokens the
+    /// image tokens are emitted as one contiguous block.
+    private func imageTokenSequence(_ result: PreprocessResult) -> [Int] {
+        guard let imageBreakTokenId, let imageEndTokenId, result.mergedColumns > 0 else {
+            return Array(repeating: imageTokenId, count: result.numImageTokens)
+        }
+        var tokens: [Int] = []
+        for row in 0 ..< result.mergedRows {
+            tokens.append(contentsOf: Array(repeating: imageTokenId, count: result.mergedColumns))
+            tokens.append(row == result.mergedRows - 1 ? imageEndTokenId : imageBreakTokenId)
+        }
+        return tokens
     }
 
