+    // MARK: - Timestamp decoding
+
+    struct TimedSegment: Sendable {
+        let start: Double
+        let end: Double
+        let text: String
+    }
+
+    /// Seconds represented by one Whisper timestamp token.
+    static let secondsPerTimestampToken = 0.02
+    /// Whisper limits the first timestamp to one second into the window.
+    static let maxInitialTimestampIndex = 50
+
+    /// Port of openai/whisper `ApplyTimestampRules`, applied to one step of CPU logits.
+    /// `generated` holds only the tokens sampled after the prompt.
+    static func applyTimestampRules(
+        to logits: inout [Float],
+        generated: [Int],
+        timestampBegin: Int,
+        endOfText: Int,
+        noTimestamps: Int
+    ) {
+        let count = logits.count
+        guard timestampBegin < count else { return }
+        let suppressed: Float = -1e9
+        if noTimestamps >= 0, noTimestamps < count { logits[noTimestamps] = suppressed }
+
+        let lastWasTimestamp = (generated.last ?? -1) >= timestampBegin
+        let penultimateWasTimestamp = generated.count < 2 || generated[generated.count - 2] >= timestampBegin
+        if lastWasTimestamp {
+            if penultimateWasTimestamp {
+                // A completed pair must be followed by text or end-of-text.
+                for index in timestampBegin..<count { logits[index] = suppressed }
+            } else {
+                // A single open timestamp must be followed by a timestamp or end-of-text.
+                for index in 0..<min(endOfText, count) { logits[index] = suppressed }
+            }
+        }
+
+        let timestamps = generated.filter { $0 >= timestampBegin }
+        if let lastTimestamp = timestamps.last {
+            let floorToken = lastWasTimestamp && !penultimateWasTimestamp ? lastTimestamp : lastTimestamp + 1
+            if floorToken > timestampBegin {
+                for index in timestampBegin..<min(floorToken, count) { logits[index] = suppressed }
+            }
+        }
+
+        if generated.isEmpty {
+            for index in 0..<timestampBegin { logits[index] = suppressed }
+            let lastAllowed = timestampBegin + maxInitialTimestampIndex
+            if lastAllowed + 1 < count {
+                for index in (lastAllowed + 1)..<count { logits[index] = suppressed }
+            }
+        }
+
+        // If timestamps are collectively more likely than any single text token, force one.
+        let maximum = logits.max() ?? 0
+        var total: Float = 0
+        for value in logits { total += expf(value - maximum) }
+        let logTotal = logf(total) + maximum
+        var timestampMass: Float = 0
+        for index in timestampBegin..<count { timestampMass += expf(logits[index] - logTotal) }
+        let timestampLogProb = logf(max(timestampMass, Float.leastNormalMagnitude))
+        let maxTextLogProb = (logits[0..<timestampBegin].max() ?? suppressed) - logTotal
+        if timestampLogProb > maxTextLogProb {
+            for index in 0..<timestampBegin { logits[index] = suppressed }
+        }
+    }
+
+    /// Splits sampled tokens into `<|start|> text <|end|>` segments. Times are seconds from the
+    /// start of the chunk and are clamped to the chunk length.
+    static func timedSegments(
+        from tokens: [Int],
+        timestampBegin: Int,
+        chunkSeconds: Double,
+        decode: ([Int]) -> String
+    ) -> [TimedSegment] {
+        var segments: [TimedSegment] = []
+        var textTokens: [Int] = []
+        var start: Double?
+        var previousEnd = 0.0
+
+        func flush(end: Double) {
+            let text = decode(textTokens).trimmingCharacters(in: .whitespacesAndNewlines)
+            textTokens.removeAll()
+            guard !text.isEmpty else { return }
+            let begin = min(start ?? previousEnd, chunkSeconds)
+            let finish = max(begin, min(end, chunkSeconds))
+            segments.append(TimedSegment(start: begin, end: finish, text: text))
+            previousEnd = finish
+            start = nil
+        }
+
+        for token in tokens {
+            if token >= timestampBegin {
+                let time = min(Double(token - timestampBegin) * secondsPerTimestampToken, chunkSeconds)
+                if textTokens.isEmpty { start = time } else { flush(end: time) }
+            } else {
+                textTokens.append(token)
+            }
+        }
+        // Decoding stopped without a closing timestamp: the segment runs to the end of the chunk.
+        if !textTokens.isEmpty { flush(end: chunkSeconds) }
+        return segments
     }
 
